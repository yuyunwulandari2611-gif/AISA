# GEMINI_API_KEY: Optional if AI extensions are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Server-side database connection for instant grades, question bank, and logs.
# Configure these in the AI Studio Secrets panel.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# GOOGLE APPS SCRIPT (GAS) WEB APP: Manages Google Drive media & score backups.
# Deploy Code.gs as a Web App and paste the /exec URL and shared secret in Secrets.
GAS_DRIVE_WEBAPP_URL=""
GAS_API_SECRET=""
GAS_DRIVE_FOLDER_ID=""
